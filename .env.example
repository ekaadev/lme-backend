# CONFIGURATION
ENVIRONMENT=DEVELOPMENT  # DEVELOPMENT or PRODUCTION (affects cookie samesite)

# Application Settings
APP_NAME=LyricMeaningExplanation
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database Settings (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lme_db

# Security Settings
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Cache Settings
REDIS_URL=redis://localhost:6379/0

# External API
GENIUS_ACCESS_TOKEN=your-genius-access-token
